<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>외교 MBTI — 나의 외교 스타일은?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
<script src="https://t1.kakaocdn.net/kakao_js_sdk/2.8.2/kakao.min.js" crossorigin="anonymous"></script>
<style>
:root{
  --bg:#07111f;--sf:#0d1a2b;--sf2:#12243a;--sf3:#17304d;
  --bd:rgba(190,211,238,.13);--bdh:rgba(190,211,238,.3);
  --tx:#edf4ff;--sub:rgba(237,244,255,.72);--dim:rgba(237,244,255,.42);
  --ac:#244da5;--ac2:#4d73bf;--ac3:#7e9bd8;--paper:#eef3f9;--ink:#10233c;
  --stamp:#87a8e2;--danger:#f58c8c;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Noto Sans KR',sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;overflow-x:hidden}
button,input{font:inherit}
.bg-grid{position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(36,77,165,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(36,77,165,.055) 1px,transparent 1px);background-size:60px 60px}
.orb{position:fixed;border-radius:50%;filter:blur(100px);pointer-events:none;z-index:0}.o1{width:min(620px,85vw);height:min(620px,85vw);background:rgba(36,77,165,.15);top:-22%;left:-12%}.o2{width:min(500px,70vw);height:min(500px,70vw);background:rgba(126,155,216,.08);bottom:-18%;right:-10%}
.w{position:relative;z-index:1;max-width:700px;margin:0 auto;padding:0 clamp(1rem,4vw,2rem)}
.screen{display:none!important}.screen.active{display:block!important}#intro.active,#loading.active,#tie.active{display:flex!important;flex-direction:column;align-items:center}
/* intro */
#intro{min-height:100vh;text-align:center;padding:clamp(1.5rem,5vh,3rem) clamp(1rem,4vw,2rem);justify-content:center}
.passport-top{display:flex;align-items:center;justify-content:space-between;width:min(520px,100%);font-size:10px;letter-spacing:.14em;color:var(--dim);margin-bottom:1rem;text-transform:uppercase}
.passport-seal{width:74px;height:74px;border:1px solid rgba(126,155,216,.45);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.1rem;position:relative;color:var(--stamp);font-size:23px}
.passport-seal::before,.passport-seal::after{content:"";position:absolute;inset:7px;border:1px dashed rgba(126,155,216,.4);border-radius:50%}.passport-seal::after{inset:16px;border-style:solid;opacity:.35}.passport-seal svg{width:40px;height:40px;fill:none;stroke:currentColor;stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round}
.ibadge{display:inline-flex;align-items:center;gap:8px;font-size:clamp(10px,2.5vw,12px);letter-spacing:.08em;color:#d9e5fb;border:1px solid rgba(126,155,216,.32);background:rgba(36,77,165,.18);padding:6px 16px;border-radius:99px;margin-bottom:clamp(1rem,3vh,1.7rem)}
.ititle{font-family:'Noto Serif KR',serif;font-size:clamp(1.8rem,6vw,3.25rem);font-weight:700;line-height:1.25;margin-bottom:.9rem}.ititle span{color:#9db7e9}
.isub{font-size:clamp(13px,3.5vw,16px);color:var(--sub);line-height:1.8;max-width:520px;margin:0 auto clamp(1.2rem,3vh,2rem)}
.ticket-hero{width:min(540px,100%);background:linear-gradient(145deg,#10233c,#0c1828);border:1px solid rgba(126,155,216,.25);border-radius:15px;padding:1rem 1.15rem;margin:0 auto 1.2rem;text-align:left;box-shadow:0 18px 60px rgba(0,0,0,.18);position:relative;overflow:hidden}
.ticket-hero::before,.ticket-hero::after{content:"";position:absolute;width:17px;height:17px;background:var(--bg);border-radius:50%;top:50%;transform:translateY(-50%)}.ticket-hero::before{left:-9px}.ticket-hero::after{right:-9px}
.ticket-route{display:flex;justify-content:space-between;gap:12px;align-items:center}.ticket-city{font-weight:700;color:#dfe9f8;font-size:12px;letter-spacing:.05em}.ticket-city small{display:block;color:var(--dim);font-weight:400;font-size:9px;margin-bottom:4px;letter-spacing:.12em}.ticket-line{flex:1;height:1px;background:linear-gradient(90deg,rgba(126,155,216,.15),rgba(126,155,216,.65),rgba(126,155,216,.15));position:relative}.ticket-line .route-mark{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:24px;height:24px;border-radius:50%;background:#10233c;display:flex;align-items:center;justify-content:center;color:var(--ac3);border:1px solid rgba(126,155,216,.35)}.ticket-line .route-mark svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.ticket-meta{display:flex;justify-content:space-between;margin-top:.85rem;padding-top:.8rem;border-top:1px dashed rgba(126,155,216,.2);font-size:10px;color:var(--dim);letter-spacing:.07em}.ticket-meta b{color:#c9d7ed;font-weight:500}
.imeta{display:flex;flex-wrap:wrap;gap:.8rem 1.35rem;justify-content:center;font-size:clamp(11px,3vw,13px);color:var(--dim);margin-bottom:clamp(1.3rem,3.5vh,2rem)}.imeta span::before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--ac2);vertical-align:middle;margin-right:6px}
.nwrap{width:100%;max-width:380px;margin:0 auto 1rem}.nlbl{font-size:13px;color:var(--dim);margin-bottom:8px;text-align:left;display:block}.ninp,.minp{width:100%;padding:.88rem 1.05rem;background:#0b1727;border:1px solid var(--bd);border-radius:10px;color:var(--tx);font-family:'Noto Sans KR',sans-serif;font-size:clamp(14px,3.5vw,16px);outline:none;transition:border-color .2s;-webkit-appearance:none}.ninp::placeholder,.minp::placeholder{color:var(--dim)}.ninp:focus,.minp:focus{border-color:var(--ac2)}.nerr,.merr{font-size:12px;color:var(--danger);margin-top:6px;text-align:left;display:none}
.sbtn,.tie-btn{display:inline-flex;align-items:center;gap:10px;font-family:'Noto Sans KR',sans-serif;font-size:clamp(14px,3.5vw,16px);font-weight:700;color:#fff;background:linear-gradient(135deg,#244da5,#486ec0);border:1px solid rgba(170,194,238,.25);border-radius:9px;padding:.82rem 1.55rem;cursor:pointer;transition:transform .2s,box-shadow .2s;box-shadow:0 12px 32px rgba(36,77,165,.24);-webkit-tap-highlight-color:transparent}.sbtn:hover,.tie-btn:hover{transform:translateY(-2px);box-shadow:0 16px 38px rgba(36,77,165,.34)}.sbtn:active,.tie-btn:active{transform:scale(.98)}
.tprev{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:1.25rem}.tchip{display:inline-flex;align-items:center;gap:6px;font-size:clamp(11px,2.8vw,12px);padding:5px 11px;border:1px solid var(--bd);border-radius:4px;color:var(--dim);background:rgba(255,255,255,.015)}.chip-icon{display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;color:#a9bde2}.chip-icon svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.alink{margin-top:1.5rem}.alink button{background:none;border:none;color:var(--dim);font-size:11px;cursor:pointer;text-decoration:underline;font-family:'Noto Sans KR',sans-serif}
/* modal */
.mbd{position:fixed;inset:0;z-index:100;background:rgba(2,7,14,.82);display:none;align-items:center;justify-content:center;padding:1.5rem}.mbd.open{display:flex}.mbox{background:#0e1a2a;border:1px solid var(--bd);border-radius:14px;padding:clamp(1.4rem,5vw,1.9rem);width:100%;max-width:360px}.mtitle{display:flex;align-items:center;gap:7px;font-size:16px;font-weight:700;margin-bottom:1rem}.ui-title-icon{display:inline-flex;width:22px;height:22px;color:#9db7e9}.ui-title-icon svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.mbtns{display:flex;gap:8px;margin-top:.2rem}.mcancel,.mok{flex:1;padding:.72rem;border-radius:9px;font-family:'Noto Sans KR',sans-serif;font-size:14px;cursor:pointer}.mcancel{background:none;border:1px solid var(--bd);color:var(--sub)}.mok{background:linear-gradient(135deg,#244da5,#486ec0);border:none;color:#fff;font-weight:700}
/* quiz */
#quiz{padding:clamp(.8rem,2vh,1.5rem) 0 clamp(3rem,8vh,5rem);min-height:100vh}.qhdr{display:flex;justify-content:space-between;align-items:center;padding:clamp(.8rem,2vh,1.1rem) 0 clamp(.9rem,2.5vh,1.4rem)}.qlogo{font-family:'Noto Serif KR',serif;font-size:14px;color:#cbdaf0}.qlogo span{color:var(--ac3)}.qright{text-align:right}.qcnt{font-size:13px;color:var(--dim)}.qnam{font-size:12px;color:var(--sub);margin-top:2px}
.ptrack{width:100%;height:3px;background:var(--bd);border-radius:99px;margin-bottom:clamp(1.35rem,4vh,2rem);overflow:hidden}.pfill{height:100%;background:linear-gradient(90deg,#244da5,#7e9bd8);border-radius:99px;transition:width .5s cubic-bezier(.4,0,.2,1)}
.qticket{position:relative;background:var(--paper);color:var(--ink);border-radius:15px;padding:clamp(1rem,3vw,1.3rem);margin-bottom:1.2rem;box-shadow:0 18px 60px rgba(0,0,0,.14);overflow:hidden}.qticket::before,.qticket::after{content:"";position:absolute;width:17px;height:17px;background:var(--bg);border-radius:50%;top:57px}.qticket::before{left:-9px}.qticket::after{right:-9px}.qtk-top{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:9px;letter-spacing:.13em;color:#53709d;text-transform:uppercase;margin-bottom:.75rem}.qtk-code{font-weight:700}.qtk-stamp{border:1px dashed #728bb6;padding:4px 7px;transform:rotate(-4deg);font-size:8px}.qsc{font-size:clamp(10px,2.5vw,11px);letter-spacing:.08em;color:#476792;margin-bottom:.65rem;display:flex;align-items:center;gap:8px}.qscene-icon{width:23px;height:23px;display:inline-flex;align-items:center;justify-content:center;flex:none;color:#244da5;border:1px solid #b9c9df;border-radius:6px;background:#f4f7fb}.qscene-icon svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}.qctx{background:#e2eaf4;border:1px solid #ccd8e8;border-left:3px solid #244da5;border-radius:4px;padding:.78rem .88rem;font-size:clamp(12px,3vw,14px);color:#314761;line-height:1.72;margin-bottom:1rem}.qmain{font-family:'Noto Serif KR',serif;font-size:clamp(1rem,3.5vw,1.22rem);font-weight:700;line-height:1.6;margin-bottom:1rem;color:#112947}.qhint{font-size:11px;color:#617997;margin-bottom:.8rem}
.opts{display:flex;flex-direction:column;gap:9px}.opt{display:flex;align-items:flex-start;gap:10px;padding:.92rem .9rem;background:#fff;border:1px solid #d6dfeb;border-radius:10px;cursor:pointer;transition:border-color .2s,background .2s,transform .15s;text-align:left;width:100%;color:#17304d;-webkit-tap-highlight-color:transparent}.opt:active{transform:scale(.985)}@media(hover:hover){.opt:hover{border-color:#9db5d9;background:#f7f9fc;transform:translateX(3px)}}.opt.sel{border-color:#244da5;background:#eaf0fb;box-shadow:inset 0 0 0 1px rgba(36,77,165,.09)}.oa{flex-shrink:0;width:28px;height:28px;border-radius:50%;border:1px solid #c9d4e3;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#587295;margin-top:1px;background:#f7f9fc}.opt.sel .oa{background:#244da5;border-color:#244da5;color:#fff}.ot{font-size:clamp(12.8px,3.5vw,14px);line-height:1.65;color:#17304d}.opt.sel .ot{color:#1e3f77;font-weight:500}
.qticket-foot{border-top:1px dashed #c6d3e3;margin-top:1rem;padding-top:.65rem;font-size:9px;color:#71829a;display:flex;justify-content:space-between;gap:8px}.nav{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:1.15rem}.nbk,.nnx{font-family:'Noto Sans KR',sans-serif;font-size:clamp(13px,3.5vw,14px);border-radius:8px;padding:.58rem 1rem;cursor:pointer;white-space:nowrap}.nbk{color:var(--dim);background:none;border:1px solid var(--bd)}.nnx{font-weight:700;color:#fff;background:linear-gradient(135deg,#244da5,#486ec0);border:1px solid rgba(170,194,238,.2);box-shadow:0 8px 24px rgba(36,77,165,.18)}.nbk:disabled,.nnx:disabled{opacity:.25;cursor:default;box-shadow:none;transform:none}
/* loading */
#loading{min-height:100vh;gap:1.2rem;text-align:center}.lrings{position:relative;width:70px;height:70px}.ring{position:absolute;inset:0;border-radius:50%;border:2px solid transparent;animation:spin 1.2s linear infinite}.ring:nth-child(1){border-top-color:#244da5}.ring:nth-child(2){border-right-color:#7e9bd8;inset:10px;animation-duration:1s;animation-direction:reverse}.ring:nth-child(3){border-bottom-color:#d5e0f4;inset:20px;animation-duration:.8s}.ltxt{font-size:15px;color:var(--sub)}.lsub{font-size:11px;color:var(--dim)}
/* tie */
#tie{min-height:100vh;text-align:center;justify-content:center;padding:2rem 1rem}.tie-icon{width:76px;height:76px;border:1px solid rgba(126,155,216,.35);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:1.1rem;color:#9db7e9;font-size:30px}.tie-title{font-family:'Noto Serif KR',serif;font-size:clamp(1.45rem,5vw,2.05rem);margin-bottom:.7rem}.tie-desc{font-size:14px;color:var(--sub);line-height:1.8;max-width:520px;margin:0 auto 1.5rem}.tie-card{width:100%;max-width:560px;text-align:left;background:var(--paper);color:var(--ink);border-radius:15px;padding:1.15rem;margin:0 auto 1.1rem;position:relative;overflow:hidden}.tie-label{font-size:9px;color:#52709b;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.7rem}.tie-q{font-family:'Noto Serif KR',serif;font-size:1.02rem;line-height:1.6;margin-bottom:1rem}.tie-opts{display:flex;flex-direction:column;gap:8px}.tie-opt{display:flex;gap:10px;align-items:flex-start;padding:.92rem;border:1px solid #d3dfec;background:#fff;border-radius:10px;cursor:pointer;text-align:left;color:#17304d}.tie-opt:hover{border-color:#9db5d9}.tie-icon svg{width:42px;height:42px;fill:none;stroke:#b0c3e5;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}.tie-mini{width:27px;height:27px;border-radius:50%;border:1px solid #c9d4e3;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex:none;color:#587295;background:#f7f9fc}
/* result */
#result{padding:clamp(1.2rem,4vh,2.5rem) 0 clamp(4rem,10vh,6rem);min-height:100vh}.rhdr{text-align:center;padding:clamp(.8rem,2vh,1.5rem) 0 1.8rem}.reye{font-size:clamp(10px,2.8vw,12px);letter-spacing:.12em;color:#8ea9dc;margin-bottom:1.2rem}.remblem{width:clamp(88px,21vw,118px);height:clamp(88px,21vw,118px);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.35rem;border:2px solid rgba(126,155,216,.45);background:rgba(36,77,165,.17);animation:pulse 3s ease-in-out infinite}.remblem svg{width:50%;height:50%;fill:none;stroke:#b7c9e9;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.rname{font-family:'Noto Serif KR',serif;font-size:clamp(1.6rem,5.5vw,2.45rem);font-weight:700;margin-bottom:.35rem;color:#edf4ff}.rkw{font-size:clamp(12px,3vw,14px);color:#a6bce3;letter-spacing:.05em;margin-bottom:.8rem}.rlead{max-width:600px;margin:0 auto .9rem;color:#b9cae3;font-size:13px;line-height:1.75}.rnotice{font-size:clamp(10.5px,2.7vw,12px);color:var(--dim);background:var(--sf2);border-radius:6px;padding:7px 12px;display:inline-block;max-width:620px;line-height:1.6}
.rsec{margin-bottom:2.2rem}.stitle{font-size:10px;letter-spacing:.11em;color:var(--dim);margin-bottom:.95rem;display:flex;align-items:center;gap:8px}.stitle::after{content:"";flex:1;height:1px;background:var(--bd)}.rdesc{background:var(--sf);border:1px solid var(--bd);border-radius:14px;padding:clamp(1.2rem,4vw,1.7rem)}.rdesc p{font-size:clamp(13px,3.5vw,15px);line-height:1.9;color:var(--sub)}.rcore{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:9px;margin-top:1.1rem}.rcore-item{background:var(--sf2);border-radius:7px;padding:.8rem .9rem}.rcore-lbl{font-size:10px;color:var(--dim);margin-bottom:4px}.rcore-val{font-size:clamp(12px,3vw,13px);color:var(--tx);font-weight:500;line-height:1.5}
.lens-grid{display:flex;flex-direction:column;gap:8px}.lens-card{background:var(--sf);border:1px solid var(--bd);border-radius:9px;padding:.9rem 1rem}.lens-desc{font-size:12.5px;color:var(--sub);line-height:1.7}.clist{display:flex;flex-direction:column;gap:13px}.cmeta{display:flex;justify-content:space-between;margin-bottom:5px}.clbl{font-size:clamp(12px,3vw,13px);color:var(--sub)}.cpct{font-size:clamp(12px,3vw,13px);font-weight:700}.ctrack{height:8px;background:rgba(255,255,255,.06);border-radius:99px;overflow:hidden}.cfill{height:100%;border-radius:99px;width:0;transition:width 1.1s cubic-bezier(.4,0,.2,1)}
.reflect{background:linear-gradient(145deg,#10233c,#0b1829);border:1px solid rgba(126,155,216,.22);border-radius:14px;padding:1.1rem 1.15rem}.reflect-label{font-size:10px;letter-spacing:.08em;color:#7f9bcf;margin-bottom:.35rem}.reflect-lead{font-size:12px;color:#9db7e9;line-height:1.7;margin-bottom:.55rem}.reflect-q{font-family:'Noto Serif KR',serif;font-size:clamp(14px,3.8vw,16px);line-height:1.7;color:#edf4ff}.reflect-label.note-label{margin-top:.85rem}.reflect-note{font-size:11px;color:var(--dim);line-height:1.7;margin-top:.65rem}.pattern-badge{display:inline-flex;align-items:center;gap:6px;font-size:9px;letter-spacing:.08em;color:#abc0e5;background:rgba(36,77,165,.18);border:1px solid rgba(126,155,216,.23);padding:4px 7px;border-radius:4px;margin-bottom:.65rem}
.retry-wrap{text-align:center;padding-top:.7rem}.retry-btn{display:inline-flex;align-items:center;gap:7px;font-family:'Noto Sans KR',sans-serif;font-size:14px;color:var(--sub);background:none;border:1px solid var(--bd);border-radius:8px;padding:.65rem 1.6rem;cursor:pointer}.retry-btn svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
