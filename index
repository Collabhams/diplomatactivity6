상대국에 대한 신뢰가 높아져도 군사적 능력이 그대로라면, 관계 변화만으로 안보환경이 달라졌다고 볼 수 있을까요?","구성주의는 관계와 인식의 변화가 국가의 행동을 바꿀 수 있다고 봅니다. 현실주의는 그와 동시에 실제 능력과 전략적 조건이 어떻게 변했는지도 확인해야 한다고 봅니다."],"CL":["서로의 관계가 좋아진 뒤에도 국제협약이 필요하다면, 신뢰와 제도 중 어느 쪽이 협력을 오래 유지하는 데 더 중요할까요?","구성주의는 관계와 정체성의 변화가 협력의 분위기를 만들 수 있다고 보고, 자유주의는 그 협력을 공식적인 규칙과 절차로 안정시키려 합니다. 신뢰를 제도로 연결하는 과정이 왜 필요한지 생각해 보세요."],"CH":["갈등 당사자의 관계를 개선하면서도 피해를 입는 사람들을 보호해야 한다면, 두 목표를 같은 정책 안에서 어떻게 연결할 수 있을까요?","구성주의는 적대적인 인식을 바꾸는 장기적인 접근을 강조하고, 인간안보는 현재의 피해를 줄이는 직접적인 조치를 중요하게 봅니다. 장기적인 평화와 즉각적인 보호가 서로 충돌하지 않게 만드는 방법을 생각해 보세요."],"HR":["외부 위협이 크지 않은 시기에도 국가의 방어력을 계속 유지해야 한다면, 시민의 삶에 필요한 지출과 어떻게 균형을 맞출까요?","현실주의는 평소에도 미래의 위협에 대비할 국가 역량을 중요하게 보고, 인간안보는 현재 사람들의 생활과 취약성을 기준으로 정책을 평가하게 합니다. ‘미래의 위험’과 ‘현재의 필요’ 중 어느 쪽을 더 오래 바라볼지 생각해 보세요."],"HL":["국제협력을 통해 다음 위기를 막는 것과 지금 발생한 피해를 줄이는 것 중 하나를 더 크게 선택해야 한다면 어떤 기준을 세우겠습니까?","자유주의는 공동의 규칙과 제도가 미래의 반복되는 문제를 관리할 수 있다고 봅니다. 인간안보는 그 과정에서 현재의 피해가 뒤로 밀리지 않도록 실제 사람의 필요를 먼저 살펴보게 합니다."],"HC":["관계 개선을 통해 갈등을 줄이는 것과 당장의 피해를 줄이는 것 가운데 하나가 더 빨리 효과를 내야 한다면 무엇을 먼저 선택하겠습니까?","구성주의는 사람들이 서로를 바라보는 방식이 장기적인 갈등의 방향을 바꿀 수 있다고 봅니다. 인간안보는 변화가 천천히 나타나는 동안에도 사람의 생명과 생활을 보호해야 한다는 점을 강조합니다."]}};

/* 6기 재질문 무결성 확인: 각 분류(A~D)에서 12개의 '1위→2위' 조합이 모두 존재해야 합니다. */
(function validateReflections(){
  const cats=['A','B','C','D'];
  const keys=['RL','RC','RH','LR','LC','LH','CR','CL','CH','HR','HL','HC'];
  cats.forEach(cat=>{
    keys.forEach(key=>{
      if(!REFLECTIONS[cat] || !REFLECTIONS[cat][key]) console.error('Missing reflection:',cat,key);
    });
  });
})();


function buildReflection(c){
  let ord=orderedScores(c);
  if(tieWinner && c[tieWinner]===ord[0][1]){
    ord=[[tieWinner,c[tieWinner]],...ord.filter(([k])=>k!==tieWinner)];
  }
  const first=ord[0][0], second=ord[1][0];
  const firstPct=c[first]/QS.length*100, secondPct=c[second]/QS.length*100;
  let cat='D', pattern='한 관점으로 기울지만 다른 시선도 남아 있는 결과';

  if(firstPct>=50 && secondPct>=25){
    cat='A';
    pattern='강한 한 축 + 뚜렷한 두 번째 관점';
  }else if(firstPct>=50){
    cat='B';
    pattern='한 관점이 뚜렷하게 앞선 결과';
  }else if((firstPct-secondPct)<=12.5){
    cat='C';
    pattern='두 관점이 비교적 가깝게 나타난 결과';
  }

  const key=pairKey(first,second);
  const ref=REFLECTIONS[cat][key];
  if(!ref){
    console.error('Reflection data missing:',cat,key);
    return {pattern,lead:`이번 활동에서는 ${T[first].short}가 ${fmtPct(c[first])}로 가장 높았고, ${T[second].short}가 ${fmtPct(c[second])}로 뒤를 이었습니다.`,question:'이번 선택을 통해 내가 어떤 기준을 중요하게 봤는지 다시 생각해 보세요.',note:'두 관점의 차이를 비교하면서 자신의 선택이 어떤 상황에서 달라질 수 있는지도 살펴보세요.',first,second,category:cat};
  }
  const lead=`이번 활동에서는 ${T[first].short}가 ${fmtPct(c[first])}로 가장 높았고, ${T[second].short}가 ${fmtPct(c[second])}로 뒤를 이었습니다.`;
  return {pattern,lead,question:ref[0],note:ref[1],first,second,category:cat};
}

function renderResult(tk){
  const tp=T[tk], c=baseScores||getBaseScores();
  const ref=buildReflection(c);
  lastResultType=tk;
  lastReflection=ref;
  saveRec({name:uname,tk,tn:tp.name,kw:tp.kw,scores:c,time:new Date().toLocaleString('ko-KR',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'})});
  const coreHtml=tp.cores.map(x=>`<div class="rcore-item"><div class="rcore-lbl">${esc(x.l)}</div><div class="rcore-val">${esc(x.v)}</div></div>`).join('');
  const exHtml=tp.examples.map(x=>`<div class="lens-card"><div class="lens-desc">• ${esc(x)}</div></div>`).join('');
  const bars=Object.entries(T).map(([k,t])=>{const p=c[k]/QS.length*100;return`<div><div class="cmeta"><span class="clbl">${t.short}</span><span class="cpct" style="color:${t.color}">${p.toFixed(1)}%</span></div><div class="ctrack"><div class="cfill" data-p="${p}" style="background:linear-gradient(90deg,${t.color},#d8e2f5)"></div></div></div>`}).join('');
  document.getElementById('rcont').innerHTML=`
  <div class="rhdr fi"><div class="reye">YOUTH DIPLOMAT · 06 / YOUR RESULT</div><div class="remblem">${tp.icon}</div><div class="rname">당신은 ${esc(tp.name)}!</div><div class="rkw">${esc(tp.kw)}</div><div class="rlead">16개의 국제정치 상황에서 당신이 고른 선택을 모아보니, <b>${esc(tp.short)}</b>의 렌즈가 가장 자주 나타났습니다.</div><div class="rnotice">※ 실제 성격이나 정치적 성향을 진단하는 검사가 아닙니다. 국제정치를 바라보는 여러 관점을 가볍게 비교·체험하기 위한 수업용 활동입니다.</div></div>
  <div class="rsec fi"><div class="stitle">당신은 국제정치를 이렇게 바라보는 편입니다</div><div class="rdesc"><p>${esc(tp.desc)}</p><div class="rcore">${coreHtml}</div></div></div>
  <div class="rsec fi"><div class="stitle">당신의 선택에서 자주 보인 생각</div><div class="lens-grid">${exHtml}</div></div>
  <div class="rsec fi"><div class="stitle">4가지 관점 중 나의 선택 분포</div><div class="clist">${bars}</div></div>
  <div class="rsec fi"><div class="stitle">수업에서 다시 생각해볼 질문</div><div class="reflect"><div class="pattern-badge">${esc(ref.pattern)}</div><div class="reflect-lead">${esc(ref.lead)}</div><div class="reflect-label">생각해볼 질문</div><div class="reflect-q">${esc(ref.question)}</div><div class="reflect-label note-label">생각해볼 내용</div><div class="reflect-note">${esc(ref.note)}</div></div></div>
  <div class="share-wrap fi"><button class="share-btn" onclick="shareResult()"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path></svg>카카오톡으로 결과 공유</button><button class="share-btn" onclick="copyResultLink()"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 15l6-6M8 7H7a3 3 0 000 6h2M16 17h1a3 3 0 000-6h-2"></path></svg>링크 복사</button><div class="share-hint">휴대폰에서는 공유 메뉴에서 카카오톡을 선택할 수 있어요. 카카오디벨로퍼스 JavaScript 키를 연결하면 카카오톡 직접 공유도 사용할 수 있습니다.</div></div>
  <div class="retry-wrap fi"><button class="retry-btn" onclick="restart()"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 118 8M4 12V6M4 12h6"></path></svg> 다시 해보기</button></div>`;
  show('result');setTimeout(()=>document.querySelectorAll('.cfill').forEach(el=>{el.style.width=el.dataset.p+'%'}),180)
}
function shareResult(){
  const tk=lastResultType||topKeys(baseScores||getBaseScores())[0], tp=T[tk], c=baseScores||getBaseScores();
  const top=orderedScores(c).slice(0,2);
  const resultText=`${uname}님의 외교 관점 결과는 ${tp.name}! ${tp.kw}\n${T[top[0][0]].short} ${fmtPct(c[top[0][0]])} · ${T[top[1][0]].short} ${fmtPct(c[top[1][0]])}`;
  const shareUrl=window.location.href.split('#')[0];

  if(window.Kakao && typeof Kakao.isInitialized==='function' && Kakao.isInitialized()){
    try{
      Kakao.Share.sendDefault({
        objectType:'text',
        text:`${resultText}\n청소년외교관 6기 · 나의 외교 성향 알아보기`,
        link:{mobileWebUrl:shareUrl,webUrl:shareUrl}
      });
      return;
    }catch(e){console.warn('Kakao share failed; using native share.',e)}
  }

  if(navigator.share){
    navigator.share({title:'외교 MBTI — 나의 외교 스타일은?',text:resultText,url:shareUrl}).catch(()=>{});
    return;
  }
  copyTextWithFallback(`${resultText}\n${shareUrl}`,'결과 내용과 링크를 복사했습니다. 카카오톡 채팅창에 붙여넣어 공유해 주세요.');
}
function copyResultLink(){
  const tk=lastResultType||topKeys(baseScores||getBaseScores())[0], tp=T[tk];
  const shareUrl=window.location.href.split('#')[0];
  copyTextWithFallback(`나의 외교 관점: ${tp.name}!\n${shareUrl}`,'결과 링크를 복사했습니다.');
}
function copyText(text){
  if(navigator.clipboard && window.isSecureContext){return navigator.clipboard.writeText(text)}
  return new Promise((resolve,reject)=>{try{const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();const ok=document.execCommand('copy');ta.remove();ok?resolve():reject(new Error('copy command failed'))}catch(e){reject(e)}})
}
function copyTextWithFallback(text,successMessage){
  return copyText(text).then(()=>{if(successMessage)alert(successMessage)}).catch(()=>{
    try{window.prompt('아래 내용을 복사해 주세요.',text)}catch(e){alert(text)}
  })
}

function restart(){cur=0;ans=[];baseScores=null;tieWinner=null;tieQueue=[];document.getElementById('ninp').value='';show('intro')}

/* admin */
let af='all';
function showAdm(){renderAdm();show('admin')}
function renderAdm(){
  const recs=getRec(),tc={R:0,L:0,C:0,H:0};recs.forEach(r=>{if(tc[r.tk]!==undefined)tc[r.tk]++});
  document.getElementById('adstats').innerHTML=`<div class="stcrd"><div class="stemi"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="15"></circle><path d="M24 9v30M9 24h30"></path></svg></div><div class="stnum">${recs.length}</div><div class="stlbl">총 참여자</div></div>${Object.entries(T).map(([k,t])=>`<div class="stcrd"><div class="stemi">${t.icon}</div><div class="stnum" style="color:${t.color}">${tc[k]}</div><div class="stlbl">대표 관점</div></div>`).join('')}`;
  document.getElementById('frow').innerHTML=`<button class="fbtn" onclick="setF('all')">전체 (${recs.length})</button>${Object.entries(T).map(([k,t])=>`<button class="fbtn" onclick="setF('${k}')">${t.short} ${tc[k]}</button>`).join('')}`;
  const fl=af==='all'?recs:recs.filter(r=>r.tk===af),le=document.getElementById('rlist');
  if(fl.length===0){le.innerHTML='<div class="empty">아직 참여자가 없습니다.</div>';return}
  le.innerHTML=fl.slice().reverse().map((r,i)=>`<div class="rrow"><div class="rnum">${fl.length-i}</div><div class="remi">${T[r.tk]?.icon||''}</div><div class="rinfo"><div class="rnam">${esc(r.name)}</div><div class="rtyp">${esc(r.tn)} · ${esc(r.kw)}</div></div><div class="rtim">${esc(r.time||'')}</div></div>`).join('')
}
function setF(f){af=f;renderAdm()}
function clrAll(){if(confirm('전체 데이터를 초기화할까요?')){clrRec();renderAdm()}}
function exitAdm(){show('intro')}
</script>
