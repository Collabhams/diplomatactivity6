<script>
/* =========================================================
   청소년외교관 6기 · 국제정치 관점 체험 활동
   4개 관점
   R: Realism
   L: Liberalism
   C: Constructivism
   H: Human Security approach

   문항 설계:
   - 16문항 × 3선택지 = 48개 선택지
   - 각 관점은 정확히 12회씩 선택지로 노출
   - 문항별 3개 관점만 제시하여 선택의 여지를 유지
   - 정답/오답이 없으며, 결과는 '선택 분포'로 해석
========================================================= */

const T = {
  R:{
    name:'현실주의자', short:'현실주의', color:'#6f91cf',
    kw:'힘 · 안보 · 국익',
    icon:`<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5l14 7v10c0 10-6.5 17.2-14 21-7.5-3.8-14-11-14-21V12l14-7z"/><path d="M16 19h16M18 24h12M20 29h8"/></svg>`,
    desc:'국제정치를 바라볼 때 국가의 생존과 안전, 힘의 차이를 먼저 살피는 편입니다. 상대국이 무엇을 약속하는지도 중요하지만, 실제로 어떤 능력을 가지고 있고 그 능력을 어떻게 사용할 수 있는지에 더 눈이 갑니다. 그래서 억지력, 군사적 대비, 국익, 힘의 균형 같은 요소가 중요한 판단 기준이 될 수 있습니다.',
    cores:[
      {l:'핵심 질문',v:'우리 국가는 스스로를 지킬 수 있는가?'},
      {l:'눈여겨보는 것',v:'힘 · 안보 · 상대의 능력'},
      {l:'장점',v:'위기에서 위험과 비용을 빠르게 계산하기'},
      {l:'생각해볼 점',v:'상대의 행동을 위협으로만 읽고 있지는 않은가?'}
    ],
    examples:['상대국의 군사력과 실제 행동을 중요하게 본다.','협력이 필요해도 우리 국가의 안전에 미칠 영향을 먼저 본다.','상대가 공격할 이유뿐 아니라 공격할 능력이 있는지도 살핀다.']
  },
  L:{
    name:'자유주의자', short:'자유주의', color:'#8aa8de',
    kw:'협력 · 규칙 · 제도',
    icon:`<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 13h13v13H9zM26 22h13v13H26z"/><path d="M22 18h4v4M22 26h4v-4"/><path d="M13 35h22"/></svg>`,
    desc:'국가들이 경쟁만 하는 것이 아니라, 함께 만든 규칙과 제도를 통해 문제를 줄여갈 수 있다고 보는 편입니다. 혼자서 힘을 키우는 것만큼 서로 정보를 나누고, 약속을 만들고, 반복해서 협력할 구조를 만드는 것을 중요하게 봅니다. 국제기구나 조약이 모든 문제를 해결해주지는 않더라도, 갈등을 관리할 장치를 만드는 데 의미가 있다고 봅니다.',
    cores:[
      {l:'핵심 질문',v:'서로 지킬 수 있는 규칙을 만들 수 있는가?'},
      {l:'눈여겨보는 것',v:'협력 · 제도 · 공동의 이익'},
